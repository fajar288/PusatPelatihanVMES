# Salin ke .env.local untuk pengembangan lokal.
# URL publik situs — dipakai metadataBase, sitemap, robots, JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API Laravel (dipanggil dari browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# API Laravel dari server Next (SSR/ISR); di docker compose = http://backend:8000/api/v1
API_URL_INTERNAL=http://localhost:8000/api/v1

# Rahasia webhook revalidasi cache CMS (POST /api/revalidate, header x-revalidate-secret)
REVALIDATE_SECRET=ganti-dengan-string-acak
