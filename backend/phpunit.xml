<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Tes tidak boleh memicu webhook revalidasi ke dev server frontend yang sedang berjalan (tes yang perlu menyetelnya sendiri). -->
        <env name="REVALIDATE_SECRET" value="" force="true"/>
        <!-- Fitur AI selalu mati di tes (tidak bergantung .env lokal); tes yang butuh menyalakannya lewat config(). -->
        <env name="AI_ENABLED" value="false" force="true"/>
        <env name="AI_EARLY_WARNING_ENABLED" value="false" force="true"/>
        <env name="AI_RECOMMENDATION_ENABLED" value="false" force="true"/>
        <env name="AI_FEEDBACK_ENABLED" value="false" force="true"/>
        <env name="AI_CORPORATE_INSIGHT_ENABLED" value="false" force="true"/>
        <env name="AI_DEMAND_FORECAST_ENABLED" value="false" force="true"/>
        <env name="AI_CHATBOT_ENABLED" value="false" force="true"/>
        <env name="CHATBOT_ENABLED" value="false" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
    </php>
</phpunit>
