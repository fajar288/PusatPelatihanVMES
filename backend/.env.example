APP_NAME="PPTI VMES ITMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Frontend Next.js (CORS + Sanctum stateful). Beberapa origin dipisah koma.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# Webhook revalidasi cache frontend (harus sama dengan REVALIDATE_SECRET di frontend/.env.local)
REVALIDATE_SECRET=

# Akun super admin awal (php artisan db:seed --class=AdminUserSeeder) — GANTI di produksi
ADMIN_EMAIL=admin@pusatpelatihan.id
ADMIN_PASSWORD=password

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (docker compose up -d postgres). Untuk coba cepat tanpa Docker: DB_CONNECTION=sqlite
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ppti
DB_USERNAME=ppti
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
# public = disk lokal (storage:link); s3 = S3-compatible (isi AWS_* di bawah)
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@pusatpelatihan.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API Publik (Phase 5): batas default per klien/menit, retensi log permintaan & webhook (hari), timeout webhook (detik)
PUBLIC_API_RATE_LIMIT=60
API_LOG_RETENTION_DAYS=90
WEBHOOK_TIMEOUT=10

# Web Push PWA (notifikasi push portal): buat dengan `php artisan webpush:vapid`. Kosong = push nonaktif.
# Di PHP Windows (dev) set env OPENSSL_CONF=<php>/extras/ssl/openssl.cnf dan curl.cainfo agar enkripsi & HTTPS ke push service berjalan.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pusatpelatihan.id

# Notification Engine (Roadmap 5D). Jadwalkan `php artisan schedule:run` tiap menit (notifications:dispatch = retry & terjadwal).
NOTIFICATIONS_INLINE=true
NOTIFICATIONS_MAX_ATTEMPTS=4
NOTIFICATIONS_RISK_ENABLED=true
# WhatsApp: penyedia DITUNDA — hanya driver log (pesan ditulis ke log). Biarkan false sampai penyedia diputuskan.
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=log
WHATSAPP_LOG_CHANNEL=

# Chatbot informasi publik (Claude / Anthropic API) — nonaktif bawaan.
# Aktif hanya bila CHATBOT_ENABLED=true DAN ANTHROPIC_API_KEY terisi.
CHATBOT_ENABLED=false
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-opus-5-5
CHATBOT_EFFORT=low
CHATBOT_PER_IP_PER_MINUTE=6
CHATBOT_PER_IP_PER_DAY=40
CHATBOT_DAILY_LIMIT=500
CHATBOT_LOG_RETENTION_DAYS=90
