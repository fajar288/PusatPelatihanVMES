# .env PRODUKSI backend Laravel di cPanel (api.pusatpelatihan.id).
# Salin ke ~/ppti/backend/shared/.env lalu isi nilainya. JANGAN commit berkas hasil isian.
# Penjelasan tiap bagian: docs/deploy-cpanel.md bagian "Isi .env produksi".
# Nilai rahasia dibiarkan kosong di contoh ini; buat dengan perintah di komentarnya.

# ---------------------------------------------------------------- Aplikasi
APP_NAME="PPTI VMES ITMS"
# production: matikan halaman debug & aktifkan proteksi produksi
APP_ENV=production
# Isi otomatis: php artisan key:generate (sekali saja; jangan diganti setelah ada data, sidik nama sertifikat memakainya)
APP_KEY=
# WAJIB false di produksi (true membuka detail galat & konfigurasi ke pengunjung)
APP_DEBUG=false
# URL backend (subdomain API) tanpa garis miring di akhir; dipakai URL berkas, tautan email, panel admin
APP_URL=https://api.pusatpelatihan.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------- Frontend & keamanan lintas domain
# URL frontend Next.js: CORS, tautan reset sandi/verifikasi email, webhook revalidasi cache. Beberapa origin dipisah koma.
FRONTEND_URL=https://pusatpelatihan.id
# Domain yang boleh memakai cookie sesi Sanctum (frontend memakai token Bearer, jadi cukup domain frontend)
SANCTUM_STATEFUL_DOMAINS=pusatpelatihan.id,www.pusatpelatihan.id
# Umur token login (menit), 43200 = 30 hari
SANCTUM_EXPIRATION=43200
# Rahasia webhook revalidasi cache frontend; HARUS sama dengan REVALIDATE_SECRET di frontend.
# Buat: php -r "echo bin2hex(random_bytes(32));"
REVALIDATE_SECRET=
# Rahasia penerusan IP pengunjung dari server frontend; HARUS sama dengan API_PROXY_SECRET di frontend.
# Buat: php -r "echo bin2hex(random_bytes(32));"
API_PROXY_SECRET=

# Akun super admin awal (php artisan db:seed --class=AdminUserSeeder). Pakai email nyata & sandi kuat,
# lalu kosongkan ADMIN_PASSWORD setelah login pertama dan ganti sandi di panel.
ADMIN_EMAIL=
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- Log
LOG_CHANNEL=stack
# daily: satu berkas per hari di storage/logs, otomatis dihapus setelah LOG_DAILY_DAYS
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------- Database (cPanel: MySQL Databases)
# MySQL 8.0.16+ atau MariaDB 10.4+ (docs/database.md). Server MariaDB boleh memakai DB_CONNECTION=mariadb.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# cPanel menambahkan awalan nama akun, mis. akunanda_ppti
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------- Sesi, cache, antrean (tanpa Redis/supervisor)
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookie sesi panel admin hanya terkirim lewat HTTPS
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
# Kosong = cookie panel admin hanya untuk api.pusatpelatihan.id (tidak dibagi ke frontend; frontend memakai token)
SESSION_DOMAIN=
BROADCAST_CONNECTION=log
# Antrean di tabel jobs, dijalankan cron `queue:work --stop-when-empty` tiap menit (tidak ada supervisor di cPanel)
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=ppti_

# ---------------------------------------------------------------- Berkas
# public = storage/app/public lewat public/storage (php artisan storage:link). s3 bila memakai object storage.
FILESYSTEM_DISK=public
# Berkas pribadi (dokumen pendaftaran, bukti bayar, tugas, logbook) tanpa URL publik
FILESYSTEM_PRIVATE_DISK=local

# ---------------------------------------------------------------- Email (cPanel: Email Accounts, atau SMTP penyedia)
# smtp untuk kirim sungguhan; log hanya menulis ke log (uji). Penyedia email belum diputuskan.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
# Host SMTP cPanel biasanya mail.pusatpelatihan.id, port 465 (SSL)
MAIL_HOST=mail.pusatpelatihan.id
MAIL_PORT=465
MAIL_USERNAME=noreply@pusatpelatihan.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@pusatpelatihan.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Object storage (opsional, belum dipakai)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------- API Publik
PUBLIC_API_RATE_LIMIT=60
API_LOG_RETENTION_DAYS=90
WEBHOOK_TIMEOUT=10

# ---------------------------------------------------------------- Web Push (opsional)
# Buat sekali: php artisan webpush:vapid (mengisi dua kunci ini). Kosong = notifikasi push nonaktif.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@pusatpelatihan.id

# ---------------------------------------------------------------- Notifikasi
# true: pesan dikirim langsung saat peristiwa terjadi; retry & pesan terjadwal lewat cron schedule:run
NOTIFICATIONS_INLINE=true
NOTIFICATIONS_MAX_ATTEMPTS=4
NOTIFICATIONS_RISK_ENABLED=true

# ---------------------------------------------------------------- WhatsApp (MATI sampai pemilik proyek mengaktifkan Fonnte)
WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=log
WHATSAPP_LOG_CHANNEL=
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
# Buat: php -r "echo bin2hex(random_bytes(24));"  (URL webhook /api/webhooks/fonnte/{secret}/status|device)
FONNTE_WEBHOOK_SECRET=
FONNTE_TIMEOUT=15

# ---------------------------------------------------------------- AI (SEMUA MATI sampai disetujui pemilik proyek)
CHATBOT_ENABLED=false
ANTHROPIC_API_KEY=
AI_ENABLED=false
AI_CHATBOT_ENABLED=false
AI_EARLY_WARNING_ENABLED=false
AI_RECOMMENDATION_ENABLED=false
AI_FEEDBACK_ENABLED=false
AI_CORPORATE_INSIGHT_ENABLED=false
AI_DEMAND_FORECAST_ENABLED=false

# ---------------------------------------------------------------- Privasi
# Tenggat proses permintaan hapus data (hari). Aturan retensi otomatis tetap kosong sampai kebijakan PPTI ditetapkan.
PRIVACY_DELETION_DEADLINE_DAYS=14
PRIVACY_REGISTRATION_DOCUMENTS_DAYS=
PRIVACY_CLOSED_REGISTRATION_DAYS=
PRIVACY_WAITLIST_DAYS=

# ---------------------------------------------------------------- Backup (php artisan backup:database)
# Dump database terkompresi tiap malam ke storage/app/backups (di luar public), rotasi 7 harian + 4 mingguan
BACKUP_ENABLED=true
BACKUP_TIME=01:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# true: ikut arsipkan storage/app/private (dokumen, bukti bayar). Perhatikan kuota disk paket hosting.
BACKUP_INCLUDE_PRIVATE_FILES=false
# Isi bila mysqldump tidak ada di PATH cron (cek: which mysqldump)
BACKUP_MYSQLDUMP_PATH=
